{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/news",
      "destination": "/api/news.js"
    },
    {
      "source": "/api/article-full",
      "destination": "/api/article-full.js"
    },
    {
      "source": "/api/health",
      "destination": "/api/news.js?health=1"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
